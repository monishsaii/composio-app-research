      "type": "string"
     },
     "title": "Flows",
     "type": "array"
    },
    "scopes_granular": {
     "anyOf": [
      {
       "type": "boolean"
      },
      {
       "const": "unknown",
       "type": "string"
      }
     ],
     "default": "unknown",
     "title": "Scopes Granular"
    },
    "app_review_required": {
     "anyOf": [
      {
       "type": "boolean"
      },
      {
       "const": "unknown",
       "type": "string"
      }
     ],
     "default": "unknown",
     "title": "App Review Required"
    }
   },
   "title": "OAuthDetails",
   "type": "object"
  }
 },
 "properties": {
  "id": {
   "title": "Id",
   "type": "string"
  },
  "name": {
   "title": "Name",
   "type": "string"
  },
  "category": {
   "title": "Category",
   "type": "string"
  },
  "one_liner": {
   "default": "",
