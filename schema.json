      "enum": [
       "rest",
       "graphql",
       "soap",
       "sdk_only",
       "cli_only",
       "websocket",
       "other"
      ],
      "type": "string"
     },
     "title": "Style",
     "type": "array"
    },
    "breadth": {
     "default": "unknown",
     "enum": [
      "broad",
      "medium",
      "narrow",
      "none",
      "unknown"
     ],
     "title": "Breadth",
     "type": "string"
    },
    "approx_endpoint_count": {
     "anyOf": [
      {
       "type": "integer"
      },
      {
       "type": "null"
      }
     ],
     "default": null,
     "title": "Approx Endpoint Count"
    },
    "webhooks": {
     "anyOf": [
      {
       "type": "boolean"
      },
      {
       "const": "unknown",
       "type": "string"
      }
     ],
     "default": "unknown",
     "title": "Webhooks"
    },
    "pagination_documented": {
     "anyOf": [
      {
       "type": "boolean"
      },
      {
       "const": "unknown",
       "type": "string"
      }
     ],
     "default": "unknown",
     "title": "Pagination Documented"
    },
    "rate_limits_documented": {
     "anyOf": [
      {
       "type": "boolean"
      },
      {
       "const": "unknown",
       "type": "string"
      }
     ],
     "default": "unknown",
     "title": "Rate Limits Documented"
    },
    "official_sdks": {
     "default": [],
     "items": {
      "type": "string"
     },
     "title": "Official Sdks",
     "type": "array"
    }
   },
   "title": "ApiSurface",
   "type": "object"
  },
  "Buildability": {
   "properties": {
    "verdict": {
     "default": "UNCLEAR",
