     "title": "Est Tool Count If Built"
    },
    "est_effort": {
     "anyOf": [
      {
       "enum": [
        "S",
        "M",
        "L",
        "XL"
       ],
       "type": "string"
      },
      {
       "type": "null"
      }
     ],
     "default": null,
     "title": "Est Effort"
    }
   },
   "title": "Buildability",
   "type": "object"
  },
  "Evidence": {
   "properties": {
    "url": {
     "title": "Url",
     "type": "string"
    },
    "quote": {
     "description": "<=25 words, verbatim preferred",
     "title": "Quote",
     "type": "string"
    },
    "source_type": {
     "enum": [
      "official_docs",
      "pricing_page",
      "official_repo",
      "third_party",
      "none"
     ],
     "title": "Source Type",
     "type": "string"
    },
    "fetched_at": {
     "title": "Fetched At",
     "type": "string"
    },
    "support": {
     "anyOf": [
      {
       "type": "string"
      },
      {
       "type": "null"
      }
     ],
     "default": null,
     "title": "Support"
    }
   },
   "required": [
    "url",
    "quote",
    "source_type",
    "fetched_at"
   ],
   "title": "Evidence",
   "type": "object"
  },
  "Mcp": {
   "properties": {
    "exists": {
     "default": "unknown",
