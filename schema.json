  "access": {
   "default": "unknown",
   "enum": [
    "self_serve_free",
    "self_serve_trial",
    "paid_plan_required",
    "admin_approval",
    "app_review_required",
    "partner_or_contact_sales",
    "no_public_api",
    "unknown"
   ],
   "title": "Access",
   "type": "string"
  },
  "access_notes": {
   "default": "",
   "title": "Access Notes",
   "type": "string"
  },
  "sandbox_or_test_env": {
   "anyOf": [
    {
     "type": "boolean"
