    "url": {
     "anyOf": [
      {
       "type": "string"
      },
      {
       "type": "null"
      }
     ],
     "default": null,
     "title": "Url"
    }
   },
   "title": "Mcp",
   "type": "object"
  },
  "OAuthDetails": {
   "properties": {
    "flows": {
     "default": [],
