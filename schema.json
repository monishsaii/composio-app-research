      "BUILD_NOW",
      "BUILD_WITH_CAVEATS",
      "BLOCKED_NEEDS_OUTREACH",
      "BLOCKED_NO_PUBLIC_API",
      "NOT_APPLICABLE_NOT_A_SERVICE",
      "UNCLEAR"
     ],
     "title": "Verdict",
     "type": "string"
    },
    "main_blocker": {
     "default": "other",
     "enum": [
      "none",
      "partner_gate",
      "paid_plan_gate",
      "app_review",
      "enterprise_only",
      "no_api",
      "unstable_or_undocumented_api",
      "auth_complexity",
      "regulatory_or_pci",
      "cli_or_local_only",
      "ambiguous_product",
      "other"
     ],
     "title": "Main Blocker",
     "type": "string"
    },
    "rationale": {
     "default": "",
     "title": "Rationale",
     "type": "string"
    },
    "est_tool_count_if_built": {
     "anyOf": [
      {
       "type": "integer"
      },
      {
       "type": "null"
      }
     ],
