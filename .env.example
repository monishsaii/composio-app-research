# Composio (search/fetch tools via the no-auth COMPOSIO_SEARCH toolkit). Free tier is enough.
COMPOSIO_API_KEY=
COMPOSIO_USER_ID=appresearch-agent
# LLM backend: "session" (Claude Code subagents answer task files; used for shipped data) or "anthropic"
LLM_BACKEND=session
# Only needed when LLM_BACKEND=anthropic
ANTHROPIC_API_KEY=
